# ─────────────────────────────────────────────
# FRONT WEBCUP — variables d'environnement
# Copier ce fichier en .env : cp .env.example .env
# ─────────────────────────────────────────────

# URL de base de l'API (repository d'authentification)
# ⚠️ le préfixe /api est obligatoire : les routes sont montées sur /api
# ⚠️ le préfixe NEXT_PUBLIC_ est requis car le repository est utilisé
#    dans un composant client ("use client") -> exposé au navigateur
# Le navigateur n'appelle pas cette adresse directement : il appelle /api sur le site,
# que proxy.ts relaie vers elle (pas de CORS, rien à ajouter dans CLIENT_URL côté API).
# Seuls le temps réel (WebSocket) et les images /uploads la contactent en direct.
# Production : NEXT_PUBLIC_API_URL=https://api.devatoandro.madagascar.webcup.hodi.cloud/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Adresse e-mail du support ou de l'administrateur pour la bulle d'aide
# NEXT_PUBLIC_SUPPORT_EMAIL=support@votre-domaine.fr


# ── Optionnel : Next.js ───────────────────────
# Pour écraser les variables ci-dessus sans toucher au .env,
# créer un .env.local (gitignoré automatiquement).
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Minutes d'inactivité avant la déconnexion automatique de l'utilisateur connecté (défaut 30).
# Un avertissement apparaît 60 secondes avant.
# NEXT_PUBLIC_IDLE_MINUTES=30

