# ─────────────────────────────────────────────
# FRONT WEBCUP — variables d'environnement
# Copier ce fichier en .env : cp .env.example .env
# ─────────────────────────────────────────────

# URL de base de l'API (repository d'authentification)
# ⚠️ le préfixe /api est obligatoire : les routes sont montées sur /api
# ⚠️ le préfixe NEXT_PUBLIC_ est requis car le repository est utilisé
#    dans un composant client ("use client") -> exposé au navigateur
NEXT_PUBLIC_API_URL=http://localhost:5000/api


# ── Optionnel : Next.js ───────────────────────
# Pour écraser les variables ci-dessus sans toucher au .env,
# créer un .env.local (gitignoré automatiquement).
# NEXT_PUBLIC_API_URL=http://localhost:5000/api